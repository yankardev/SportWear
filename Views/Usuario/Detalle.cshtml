@model SportWear.Web.Models.Usuario
@{ ViewData["Title"] = "Detalle del usuario"; Layout = "_LayoutAdmin"; }
@section Styles { <link rel="stylesheet" href="~/css/admin-crud.css" asp-append-version="true" /> }
<div class="client-detail-card"><div class="client-detail-header"><div><span class="client-detail-label">Usuario del sistema</span><h2 class="client-detail-title">@Model.Nombres @Model.Apellidos</h2><p class="client-detail-subtitle">Información del acceso administrativo.</p></div><span class="badge-status @(Model.Activo ? "badge-active" : "badge-inactive")">@(Model.Activo ? "Activo" : "Inactivo")</span></div>
<div class="client-detail-body"><div class="client-avatar-panel"><div class="client-avatar-large">@Model.Nombres.Substring(0,1).ToUpper()@Model.Apellidos.Substring(0,1).ToUpper()</div><h3>@Model.Nombres @Model.Apellidos</h3><span>Usuario N.° @Model.UsuarioId</span></div>
<div class="client-detail-grid"><div class="client-info-item"><div class="client-info-icon"><i class="bi bi-envelope-fill"></i></div><div><span class="client-info-label">Correo</span><strong>@Model.Correo</strong></div></div>
<div class="client-info-item"><div class="client-info-icon"><i class="bi bi-shield-lock-fill"></i></div><div><span class="client-info-label">Rol</span><strong>@Model.NombreRol</strong></div></div>
<div class="client-info-item"><div class="client-info-icon"><i class="bi bi-telephone-fill"></i></div><div><span class="client-info-label">Teléfono</span><strong>@(string.IsNullOrWhiteSpace(Model.Telefono)?"No registrado":Model.Telefono)</strong></div></div>
<div class="client-info-item"><div class="client-info-icon"><i class="bi bi-calendar-check-fill"></i></div><div><span class="client-info-label">Fecha de registro</span><strong>@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</strong></div></div></div></div>
<div class="client-detail-actions"><a asp-action="Index" class="button-secondary"><i class="bi bi-arrow-left"></i> Volver</a><a asp-action="CambiarClave" asp-route-id="@Model.UsuarioId" class="button-secondary"><i class="bi bi-key-fill"></i> Cambiar contraseña</a><a asp-action="Editar" asp-route-id="@Model.UsuarioId" class="button-submit"><i class="bi bi-pencil-fill"></i> Editar</a></div></div>
