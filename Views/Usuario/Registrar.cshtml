@model SportWear.Web.ViewModels.UsuarioFormularioViewModel
@{ ViewData["Title"] = "Registrar usuario"; Layout = "_LayoutAdmin"; }
@section Styles { <link rel="stylesheet" href="~/css/admin-crud.css" asp-append-version="true" /> }
<div class="form-card"><div class="form-card-header"><h2 class="form-card-title">Registrar usuario</h2><p class="form-card-description">Cree un acceso para el personal del sistema.</p></div><div class="form-card-body">
<form asp-action="Registrar" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="form-validation"></div>
<div class="form-grid">
<div class="form-group"><label asp-for="Nombres" class="form-label"></label><input asp-for="Nombres" class="form-control-sport" /><span asp-validation-for="Nombres" class="form-validation"></span></div>
<div class="form-group"><label asp-for="Apellidos" class="form-label"></label><input asp-for="Apellidos" class="form-control-sport" /><span asp-validation-for="Apellidos" class="form-validation"></span></div>
<div class="form-group"><label asp-for="Correo" class="form-label"></label><input asp-for="Correo" class="form-control-sport" /><span asp-validation-for="Correo" class="form-validation"></span></div>
<div class="form-group"><label asp-for="Telefono" class="form-label"></label><input asp-for="Telefono" class="form-control-sport" /></div>
<div class="form-group"><label asp-for="RolId" class="form-label"></label><select asp-for="RolId" class="form-control-sport"><option value="">Seleccione un rol</option>@foreach (var rol in Model.Roles){<option value="@rol.RolId">@rol.Nombre</option>}</select><span asp-validation-for="RolId" class="form-validation"></span></div>
<div class="form-group"><label asp-for="Clave" class="form-label"></label><input asp-for="Clave" class="form-control-sport" /><span asp-validation-for="Clave" class="form-validation"></span></div>
<div class="form-group"><label asp-for="ConfirmarClave" class="form-label"></label><input asp-for="ConfirmarClave" class="form-control-sport" /><span asp-validation-for="ConfirmarClave" class="form-validation"></span></div></div>
<div class="form-actions"><a asp-action="Index" class="button-secondary">Cancelar</a><button class="button-submit">Registrar</button></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
