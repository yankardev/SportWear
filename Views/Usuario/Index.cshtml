@model List<SportWear.Web.Models.Usuario>

@{ ViewData["Title"] = "Usuarios"; Layout = "_LayoutAdmin"; }
@section Styles { <link rel="stylesheet" href="~/css/admin-crud.css" asp-append-version="true" /> }

<section class="crud-card">
    <div class="crud-header">
        <div><h2>Usuarios del sistema</h2><p>Administre los accesos del personal.</p></div>
        <a asp-action="Registrar" class="button-submit"><i class="bi bi-person-plus-fill"></i> Nuevo usuario</a>
    </div>
    <form asp-action="Index" method="get" class="search-form">
        <input name="buscar" value="@ViewBag.Buscar" class="form-control-sport" placeholder="Buscar por nombre, correo o rol" />
        <button class="button-submit" type="submit">Buscar</button>
        <a asp-action="Index" class="button-secondary">Limpiar</a>
    </form>
    <div class="table-responsive">
        <table class="crud-table">
            <thead>
             <tr>
                 <th>Usuario</th>
                 <th>Correo</th>
                 <th>Rol</th>
                 <th>Teléfono</th>
                 <th>Estado</th>
                 <th style="text-align:center">Acciones</th>
             </tr>
             </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.Nombres @item.Apellidos</strong></td>
                    <td>@item.Correo</td>
                    <td>@item.NombreRol</td>
                    <td>@(string.IsNullOrWhiteSpace(item.Telefono) ? "—" : item.Telefono)</td>
                    <td><span class="badge-status @(item.Activo ? "badge-active" : "badge-inactive")">@(item.Activo ? "Activo" : "Inactivo")</span></td>
                    <td><div class="action-buttons">
                        <a asp-action="Detalle" asp-route-id="@item.UsuarioId" class="action-button action-details" title="Detalle"><i class="bi bi-eye-fill"></i></a>
                        <a asp-action="Editar" asp-route-id="@item.UsuarioId" class="action-button action-edit" title="Editar"><i class="bi bi-pencil-fill"></i></a>
                        <a asp-action="CambiarClave" asp-route-id="@item.UsuarioId" class="action-button action-details" title="Cambiar contraseña"><i class="bi bi-key-fill"></i></a>
                        @if (item.Activo)
                        {
                            <form asp-action="Eliminar" asp-route-id="@item.UsuarioId" method="post" onsubmit="return confirm('¿Desea desactivar este usuario?');">
                                @Html.AntiForgeryToken()
                                <button class="action-button action-delete" title="Desactivar"><i class="bi bi-person-x-fill"></i></button>
                            </form>
                        }
                    </div></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
