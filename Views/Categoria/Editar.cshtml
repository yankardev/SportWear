@model SportWear.Web.Models.Categoria

@{
    ViewData["Title"] = "Editar categoría";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-crud.css" asp-append-version="true" />
}

<div class="form-card">
    <div class="form-card-header">
        <h2 class="form-card-title">
            Editar categoría
        </h2>
        <p class="form-card-description">
            Actualiza la información de la categoría.
        </p>
    </div>
    <div class="form-card-body">
        <form asp-action="Editar" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="CategoriaId" type="hidden" />
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="form-grid">

                <div class="form-group">

                    <label asp-for="Nombre"
                           class="form-label"></label>

                    <input asp-for="Nombre"
                           class="form-control-sport" />

                    <span asp-validation-for="Nombre"
                          class="form-validation"></span>

                </div>

                <div class="form-group form-group-full">

                    <label asp-for="Descripcion"
                           class="form-label"></label>

                    <textarea asp-for="Descripcion"
                              class="form-textarea-sport">
                    </textarea>

                    <span asp-validation-for="Descripcion"
                          class="form-validation"></span>

                </div>

                <div class="form-group">

                    <div class="switch-group">

                        <input asp-for="Activo"
                               class="switch-input" />

                        <div class="switch-content">

                            <strong>Activo</strong>

                            <span>
                                La categoría estará disponible para los productos.
                            </span>

                        </div>

                    </div>

                </div>

            </div>

            <div class="form-actions">

                <a asp-action="Index"
                   class="button-secondary">

                    <i class="bi bi-arrow-left"></i>

                    Cancelar

                </a>

                <button type="submit"
                        class="button-submit">

                    <i class="bi bi-check-circle-fill"></i>

                    Guardar cambios

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}