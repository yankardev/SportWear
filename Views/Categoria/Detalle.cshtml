@model SportWear.Web.Models.Cliente

@{
    ViewData["Title"] = "Detalle Cliente";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-crud.css" asp-append-version="true" />
}

<div class="detail-card">
    <div class="detail-header">
        <div>
            <h2 class="detail-title">
              @Model.Nombres @Model.Apellidos
            </h2>
            <p class="detail-subtitle">
                Información del cliente
            </p>
        </div>
    </div>

    <div class="detail-body">
        <div class="detail-list">
            <div class="detail-item">
                <span class="detail-label">
                    Documento
                </span>
                <span class="detail-value">
                    @Model.Documento
                </span>
            </div>
            <div class="detail-item">
                <span class="detail-label">
                    Teléfono
                </span>
                <span class="detail-value">
                    @Model.Telefono
                </span>
            </div>
            <div class="detail-item">
                <span class="detail-label">
                    Correo
                </span>
                <span class="detail-value">
                    @Model.Correo
                </span>
            </div>
            <div class="detail-item">
                <span class="detail-label">
                    Estado
                </span>
                <span class="detail-value">
                    @(Model.Activo ? "Activo" : "Inactivo")
                </span>
            </div>
            <div class="detail-item detail-item-full">
                <span class="detail-label">
                    Dirección
                </span>
                <span class="detail-value">
                    @Model.Direccion
                </span>
            </div>
            <div class="detail-item">
               <span class="detail-label">
                    Fecha Registro
                </span>
                <span class="detail-value">
                    @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                </span>
            </div>
        </div>
    </div>
    <div class="detail-actions">
        <a asp-action="Index" class="button-secondary">
            Volver
        </a>

        <a asp-action="Editar"  asp-route-id="@Model.ClienteId"  class="button-submit">
            Editar
        </a>
    </div>
</div>