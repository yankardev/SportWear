@model SportWear.Web.Models.Categoria

@{
    ViewData["Title"] = "Detalle categoría";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-crud.css" asp-append-version="true" />
}

<div class="detail-card">
    <div class="detail-header">
        <div>
            <h2 class="detail-title">@Model.Nombre</h2>
            <p class="detail-subtitle">Información de la categoría</p>
        </div>
    </div>

    <div class="detail-body">
        <div class="detail-list">
            <div class="detail-item">
                <span class="detail-label">ID</span>
                <span class="detail-value">@Model.CategoriaId</span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Estado</span>
                <span class="detail-value">@(Model.Activo ? "Activo" : "Inactivo")</span>
            </div>

            <div class="detail-item detail-item-full">
                <span class="detail-label">Descripción</span>
                <span class="detail-value">@(string.IsNullOrWhiteSpace(Model.Descripcion) ? "Sin descripción" : Model.Descripcion)</span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Fecha de registro</span>
                <span class="detail-value">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
        </div>
    </div>

    <div class="detail-actions">
        <a asp-action="Index" class="button-secondary">Volver</a>
        <a asp-action="Editar" asp-route-id="@Model.CategoriaId" class="button-submit">Editar</a>
    </div>
</div>
