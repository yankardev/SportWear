@model SportWear.Web.Models.Categoria

@{
    ViewData["Title"] = "Registrar categoría";
    Layout = "_LayoutAdmin";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin-crud.css"
          asp-append-version="true" />
}

<div class="form-card">

    <div class="form-card-header">

        <h2 class="form-card-title">
            Registrar categoría
        </h2>

        <p class="form-card-description">
            Registra una nueva categoría para organizar los productos.
        </p>

    </div>

    <div class="form-card-body">

        <form asp-action="Registrar" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="form-grid">

                <div class="form-group">

                    <label asp-for="Nombre"
                           class="form-label"></label>

                    <input asp-for="Nombre"
                           class="form-control-sport"
                           placeholder="Ejemplo: Polos" />

                    <span asp-validation-for="Nombre"
                          class="form-validation"></span>

                </div>

                <div class="form-group form-group-full">

                    <label asp-for="Descripcion"
                           class="form-label"></label>

                    <textarea asp-for="Descripcion"
                              class="form-textarea-sport"
                              placeholder="Descripción de la categoría">
                    </textarea>

                    <span asp-validation-for="Descripcion"
                          class="form-validation"></span>

                </div>

            </div>

            <div class="form-actions">

                <a asp-action="Index"
                   class="button-secondary">

                    <i class="bi bi-arrow-left"></i>

                    Cancelar

                </a>

                <button type="submit"
                        class="button-submit">

                    <i class="bi bi-save-fill"></i>

                    Registrar

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}