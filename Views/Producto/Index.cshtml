@model List<SportWear.Web.Models.Producto>

@{
    ViewData["Title"] = "Productos";
    Layout = "_LayoutAdmin";

    string? buscar = ViewBag.Buscar as string;
    int paginaActual = ViewBag.Pagina ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-crud.css"  asp-append-version="true" />
}

<div class="crud-header">
    <div>
        <h2 class="crud-title">
            Gestión de productos
        </h2>

        <p class="crud-description">
            Administra las prendas disponibles en el catálogo de SportWear.
        </p>
    </div>

    <a asp-controller="Producto" asp-action="Registrar" class="crud-button-primary">
        <i class="bi bi-plus-circle-fill"></i>
        Nuevo producto
    </a>

</div>
<section class="crud-card">
    <div class="crud-toolbar">
        <form asp-controller="Producto" asp-action="Index" method="get" class="crud-search-form">
            <div class="crud-search-wrapper">
                <i class="bi bi-search crud-search-icon"></i>
                <input type="text" name="buscar" value="@buscar" class="crud-search-input" placeholder="Buscar por producto o categoría..." />
            </div>
            <button type="submit" class="crud-search-button">
                Buscar
            </button>
        </form>

        @if (!string.IsNullOrWhiteSpace(buscar))
        {
            <a asp-controller="Producto"  asp-action="Index" class="crud-clear-link">
                <i class="bi bi-x-circle me-1"></i>
                Limpiar búsqueda
            </a>
        }
    </div>
    @if (Model.Count > 0)
    {
        <div class="crud-table-container">
            <table class="crud-table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Tipo</th>
                        <th>Stock</th>
                        <th>Estado</th>
                        <th>Registro</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var producto in Model)
                    {
                        <tr>
                            <td>
                                <div class="product-cell">
                                    @if (!string.IsNullOrWhiteSpace(producto.ImagenUrl))
                                    {
                                        <img src="@producto.ImagenUrl"
                                             alt="@producto.Nombre"
                                             class="product-image"
                                             onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';" />

                                        <div class="product-image-placeholder"  style="display:none;">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="product-image-placeholder">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    }

                                    <div>

                                        <p class="product-name">
                                            @producto.Nombre
                                        </p>

                                        <p class="product-description">
                                            @(string.IsNullOrWhiteSpace(producto.Descripcion)
                                                ? "Sin descripción"
                                                : producto.Descripcion)
                                        </p>

                                    </div>

                                </div>

                            </td>

                            <td>
                                @producto.NombreCategoria
                            </td>

                            <td>
                                <span class="price-text">
                                    S/ @producto.PrecioBase.ToString("N2")
                                </span>
                            </td>

                            <td>

                                @if (producto.Personalizable)
                                {
                                    <span class="badge-status badge-custom">
                                        <i class="bi bi-magic"></i>
                                        Personalizable
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status badge-standard">
                                        <i class="bi bi-bag"></i>
                                        Estándar
                                    </span>
                                }

                            </td>

                            <td>
                                @if (producto.Personalizable)
                                {
                                    <span class="badge-status badge-custom">Bajo pedido</span>
                                }
                                else
                                {
                                    <strong>@producto.Stock</strong>
                                }
                            </td>

                            <td>

                                @if (producto.Activo)
                                {
                                    <span class="badge-status badge-active">
                                        <i class="bi bi-check-circle-fill"></i>
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status badge-inactive">
                                        <i class="bi bi-x-circle-fill"></i>
                                        Inactivo
                                    </span>
                                }

                            </td>

                            <td>
                                @producto.FechaRegistro.ToString("dd/MM/yyyy")
                            </td>

                            <td>

                                <div class="action-group">

                                    <a asp-controller="Producto"
                                       asp-action="Detalle"
                                       asp-route-id="@producto.ProductoId"
                                       class="action-button action-details"
                                       title="Ver detalle">

                                        <i class="bi bi-eye-fill"></i>

                                    </a>

                                    <a asp-controller="Producto"
                                       asp-action="Editar"
                                       asp-route-id="@producto.ProductoId"
                                       class="action-button action-edit"
                                       title="Editar producto">

                                        <i class="bi bi-pencil-fill"></i>

                                    </a>

                                    @if (producto.Activo)
                                    {
                                        <form asp-controller="Producto"
                                              asp-action="Eliminar"
                                              asp-route-id="@producto.ProductoId"
                                              method="post"
                                              onsubmit="return confirm('¿Deseas desactivar este producto?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="action-button action-delete"
                                                    title="Desactivar producto">

                                                <i class="bi bi-trash-fill"></i>

                                            </button>

                                        </form>
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        @if (string.IsNullOrWhiteSpace(buscar) && totalPaginas > 1)
        {
            <div class="crud-pagination">

                <span class="pagination-info">
                    Página @paginaActual de @totalPaginas
                </span>

                <ul class="pagination-list">

                    <li>
                        <a asp-controller="Producto"
                           asp-action="Index"
                           asp-route-pagina="@(paginaActual - 1)"
                           class="pagination-link @(paginaActual <= 1 ? "disabled" : "")">

                            <i class="bi bi-chevron-left"></i>

                        </a>
                    </li>

                    @for (int numero = 1; numero <= totalPaginas; numero++)
                    {
                        <li>
                            <a asp-controller="Producto"
                               asp-action="Index"
                               asp-route-pagina="@numero"
                               class="pagination-link @(numero == paginaActual ? "active" : "")">

                                @numero

                            </a>
                        </li>
                    }

                    <li>
                        <a asp-controller="Producto"
                           asp-action="Index"
                           asp-route-pagina="@(paginaActual + 1)"
                           class="pagination-link @(paginaActual >= totalPaginas ? "disabled" : "")">

                            <i class="bi bi-chevron-right"></i>

                        </a>
                    </li>

                </ul>

            </div>
        }
    }
    else
    {
        <div class="crud-empty">

            <div class="crud-empty-icon">
                <i class="bi bi-bag-x"></i>
            </div>

            <h3>No se encontraron productos</h3>

            <p>
                Prueba con otro término de búsqueda o registra un producto.
            </p>

        </div>
    }

</section>